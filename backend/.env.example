FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Optional local API protection. When set, all POST endpoints require Authorization: Bearer <token>.
# Generate a long random value before enabling this option.
SHADOWLENS_API_TOKEN=
